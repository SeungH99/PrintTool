# Google AdSense publisher ID, e.g. ca-pub-XXXXXXXXXXXXXXXX.
# Leave empty to disable ads + CMP locally (default-denied; AdSlot shows a reserved placeholder).
# Per ADR-0001 / MVP-005: the certified CMP (Funding Choices) is configured in the
# AdSense console "Privacy & messaging"; this var only enables the loader.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=
