# Site-wide advertising switch. OFF unless set to the exact string true.
# This is a build-time flag: rebuild/redeploy after changing it.
NEXT_PUBLIC_ADSENSE_ENABLED=false

# Google AdSense publisher ID, e.g. ca-pub-XXXXXXXXXXXXXXXX.
# Keep the publisher ID while ads are paused: verification and CMP for Analytics remain available.
# Per ADR-0001 / MVP-005: the certified CMP (Funding Choices) is configured in the
# AdSense console "Privacy & messaging"; this var identifies the publisher, not the ad switch.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=

# Public site URL — used for canonical/hreflang, sitemap.xml and robots.txt
# (e.g. https://printready.example). Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
